# Server Configuration
HOST=127.0.0.1
PORT=3000

# Authentication & Security
# Required if HOST is anything other than 127.0.0.1 or localhost (minimum 16 characters)
APP_PASSWORD=
JWT_SECRET=defectlens_secure_enterprise_key_2026

# Database Storage Engine
# Defaults to file-backed JSON/SQLite transactional storage: ./data/defectlens_db.json
# PostgreSQL connection string example: postgresql://postgres:postgres@localhost:5432/defectlens
DATABASE_URL=
DATA_FILE=./data/defects.json
DB_FILE=./data/defectlens_db.json

# AI Quality Engineering Provider Configuration
# Supported providers: 'local-rules' (built-in offline deterministic domain QA generator), 'openai', 'anthropic', 'watsonx'
AI_PROVIDER=local-rules
AI_API_KEY=
AI_MODEL=gpt-4o

# IBM watsonx.ai (Optional if AI_PROVIDER=watsonx)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Monday.com Enterprise CRM Integration (Optional default board configuration)
# Credentials remain strictly on the backend and are never leaked to client browsers.
MONDAY_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJ0aWQiOjcyMDE5MTYzNCwiYWFpIjoxMSwidWlkIjoxMjEwMTAzNTEsImlhZCI6IjIwMjYtMTEtMDNUMDg6MTY6NTAuNzkwWiIsInBlciI6Im1lOndyaXRlIiwiYWN0aWQiOjEzNTM2OTgxLCJyZ24iOiJ1c2UxIn0.UlKyIrTdVVhrdJrUNyPf2Q0CxJl7W7T7YbPSOxR7TwQ
MONDAY_BOARD_ID=4017071689
MONDAY_API_VERSION=2026-10
SYNC_INTERVAL_SECONDS=60
MONDAY_COLUMN_MAP={"steps":"steps","expected":"expected"}

# Defect Analyzer Rules Tuning
ANALYZER_REQUIRED_FIELDS=description,steps,expected,actual,environment
ANALYZER_BLOCKER_REGEX=cannot log|login.*(fail|never)|payment.*(fail|blocked)|timeout|504|unauthorized
